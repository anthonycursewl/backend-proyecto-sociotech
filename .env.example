# Database
DATABASE_URL=postgresql://user:password@postgres:5432/consultorio
DB_USER=user
DB_PASSWORD=password
DB_NAME=consultorio

# MongoDB
MONGO_URI=mongodb://mongo:27017/telemetry

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_SECRET_REFRESH=your-refresh-secret-key
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_DAYS=30

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Server
PORT=5002