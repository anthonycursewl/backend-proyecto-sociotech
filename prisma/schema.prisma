generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  roleId              String
  firstName           String
  lastName            String
  isActive            Boolean   @default(true)
  refreshToken        String?   @unique
  refreshTokenExpires DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  role        Role      @relation(fields: [roleId], references: [id])
  patients        Patient[]
  createdServices Service[] @relation("ServiceCreator")
  doctorProfile   Doctor?   @relation("DoctorUser")
  appointmentCancellations AppointmentCancellation[] @relation("AppointmentCanceller")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  resource    String
  action      String
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Service {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  durationMin Int      @default(30)
  price       Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy String
  creator   User   @relation("ServiceCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  doctors      Doctor[]      @relation("DoctorServices")
  appointments Appointment[]

  @@map("services")
}

model Doctor {
  id                String   @id @default(uuid())
  userId            String   @unique
  specialty         String
  licenseNumber     String   @unique
  consultationPrice Float?
  biography         String?
  phoneNumber       String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user               User              @relation("DoctorUser", fields: [userId], references: [id], onDelete: Cascade)
  services           Service[]         @relation("DoctorServices")
  schedules          DoctorSchedule[]
  appointments       Appointment[]
  medicalRecordsAsDoctor MedicalRecord[] @relation("MedicalRecordDoctor")

  @@map("doctors")
}

model DoctorSchedule {
  id         String   @id @default(uuid())
  doctorId   String
  dayOfWeek  Int
  startTime  String
  endTime    String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek])
  @@map("doctor_schedules")
}

model Patient {
  id               String          @id @default(uuid())
  userId           String          @unique
  medicalId        String          @unique
  cedula           String?         @unique
  dateOfBirth      DateTime
  gender           String?
  occupation       String?
  civilStatus      String?
  phone            String
  address          String
  emergencyContact String
  emergencyPhone   String
  bloodType        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  appointments     Appointment[]
  medicalRecords   MedicalRecord[]
  allergies        PatientAllergy[]
  medications      PatientMedication[]
  chronicDiseases  PatientChronicDisease[]
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("patients")
}

model PatientAllergy {
  id        String   @id @default(uuid())
  patientId String
  name      String
  severity  String?
  notes     String?
  createdAt DateTime @default(now())
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_allergies")
}

model PatientMedication {
  id           String   @id @default(uuid())
  patientId    String
  name         String
  dosage       String?
  frequency    String?
  prescribedBy String?
  createdAt    DateTime @default(now())
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_medications")
}

model PatientChronicDisease {
  id          String   @id @default(uuid())
  patientId   String
  name        String
  diagnosedAt DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_chronic_diseases")
}

model MedicalRecord {
  id               String                    @id @default(uuid())
  patientId        String
  doctorId         String
  appointmentId    String?                   @unique
  chiefComplaint   String
  symptoms         String[]
  diagnosis        String
  diagnosisCode    String?                   @map("diagnosis_code")
  treatment        String
  notes            String
  isSigned         Boolean                   @default(false)
  signedAt         DateTime?
  bloodPressure    String?                   @map("blood_pressure")
  heartRate        Int?                      @map("heart_rate")
  temperature      Float?
  weight           Float?
  height           Float?
  respiratoryRate  Int?                      @map("respiratory_rate")
  oxygenSaturation Int?                      @map("oxygen_saturation")
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  prescriptions    MedicalPrescription[]
  attachments      MedicalRecordAttachment[]
  patient          Patient                   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor           Doctor                    @relation("MedicalRecordDoctor", fields: [doctorId], references: [id], onDelete: Restrict)
  appointment      Appointment?              @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([doctorId])
  @@index([patientId])
  @@map("medical_records")
}

model MedicalPrescription {
  id              String        @id @default(uuid())
  medicalRecordId String        @map("medical_record_id")
  medicationName  String        @map("medication_name")
  dosage          String?
  frequency       String?
  duration        String?
  instructions    String?
  createdAt       DateTime      @default(now()) @map("created_at")
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  @@index([medicalRecordId])
  @@map("medical_prescriptions")
}

model MedicalRecordAttachment {
  id              String        @id @default(uuid())
  medicalRecordId String
  fileUrl         String
  fileName        String
  mimeType        String
  description     String?
  uploadedAt      DateTime      @default(now())
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  @@map("medical_record_attachments")
}

model Appointment {
  id                 String    @id @default(uuid())
  patientId          String
  doctorId           String
  serviceId          String
  scheduledAt        DateTime
  status             String    @default("SCHEDULED")
  reason             String
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  patient            Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor             Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  service            Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  cancellation       AppointmentCancellation?
  medicalRecord      MedicalRecord?

  @@index([doctorId, scheduledAt])
  @@index([patientId, scheduledAt])
  @@index([status])
  @@map("appointments")
}

model AppointmentCancellation {
  id                String   @id @default(uuid())
  appointmentId     String   @unique
  cancelledBy       String
  cancelledByUser   User     @relation("AppointmentCanceller", fields: [cancelledBy], references: [id], onDelete: Restrict)
  cancellationReason String?
  cancelledAt       DateTime @default(now())
  appointment       Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([cancelledBy])
  @@map("appointment_cancellations")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

model Notification {
  id              String    @id @default(uuid())
  eventType       String
  recipientEmail  String
  recipientName   String?
  subject         String
  body            String?
  status          String    @default("PENDING")
  errorMessage    String?
  retryCount      Int       @default(0)
  maxRetries      Int       @default(3)
  lastAttemptAt   DateTime?
  sentAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("notifications")
}

model EmailVerification {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([email, code])
  @@map("email_verifications")
}

model PatientMetrics {
  id            String   @id @default(uuid())
  totalActive   Int      @default(0)
  totalInactive Int      @default(0)
  totalNew      Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@map("patient_metrics")
}
